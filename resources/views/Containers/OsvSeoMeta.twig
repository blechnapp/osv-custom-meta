{% if item is defined and item.documents is defined and item.documents|length > 0 %}
{% set customTitle = '' %}
{% set customDesc = '' %}
{% for group in item.documents[0].data.variationProperties|default([]) %}
{% for prop in group.properties|default([]) %}
{% if prop.id == 288 and prop.values.value|default('') != '' %}{% set customTitle = prop.values.value|striptags|trim %}{% endif %}
{% if prop.id == 289 and prop.values.value|default('') != '' %}{% set customDesc = prop.values.value|striptags|trim %}{% endif %}
{% endfor %}
{% endfor %}
{% if customDesc %}<meta name="description" content="{{ customDesc|slice(0,160) }}">
<meta property="og:description" content="{{ customDesc|slice(0,160) }}">{% endif %}
{% if customTitle %}<script>document.addEventListener('DOMContentLoaded',function(){var t="{{ customTitle|slice(0,60) }} | Seiffener Volkskunst";document.title=t;var og=document.querySelector('meta[property="og:title"]');if(og)og.setAttribute('content',t);});</script>{% endif %}
{% endif %}
