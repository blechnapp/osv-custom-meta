<!-- OSV-META-START -->
{% set titleProp = '' %}
{% set descProp = '' %}

{% if item is defined and item.documents is defined and item.documents|length > 0 %}
  {% set d = item.documents[0].data %}

  {% for group in d.variationProperties|default([]) %}
    {% for prop in group.properties|default([]) %}
      {% if prop.id == 288 and titleProp == '' %}
        {% set titleProp = prop.values.value|default('') %}
      {% endif %}
      {% if prop.id == 289 and descProp == '' %}
        {% set descProp = prop.values.value|default('') %}
      {% endif %}
    {% endfor %}
  {% endfor %}

  {% set name1 = d.texts.name1|default('') %}
  {% set brand = d.manufacturer.name|default('') %}

  {% if titleProp %}
    {% set metaTitle = titleProp|striptags|trim %}
  {% else %}
    {% set metaTitle = name1|striptags|trim %}
  {% endif %}

  {% if brand %}
    {% set metaTitle = metaTitle ~ ' | ' ~ brand|striptags|trim %}
  {% endif %}

  {% set metaTitle = metaTitle ~ ' | Seiffener Volkskunst' %}

  {% if descProp %}
    {% set metaDesc = descProp|striptags|trim %}
  {% else %}
    {% set metaDesc = d.texts.metaDescription|default('')|striptags|trim %}
  {% endif %}

  {% if not metaDesc %}
    {% set metaDesc = d.texts.shortDescription|default('')|striptags|trim %}
  {% endif %}

<title>{{ metaTitle }}</title>
<meta name="description" content="{{ metaDesc|slice(0,160) }}">
<meta property="og:title" content="{{ metaTitle }}">
<meta property="og:description" content="{{ metaDesc|slice(0,160) }}">
{% endif %}
<script>
document.addEventListener('DOMContentLoaded',function(){
  var titles=document.querySelectorAll('title');
  for(var i=1;i<titles.length;i++){titles[i].remove();}
  var seen={};
  document.querySelectorAll('meta[property="og:title"],meta[property="og:description"],meta[name="description"]').forEach(function(m){
    var k=m.getAttribute('property')||m.getAttribute('name');
    if(seen[k]){m.remove();}else{seen[k]=true;}
  });
});
</script>
<!-- OSV-META-END -->
