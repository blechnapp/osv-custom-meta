{# ========== OSV CUSTOM META (SSR) v1.5.0 ========== #}
{% set PROP_TITLE_ID = 288 %}
{% set PROP_DESC_ID  = 289 %}

{% macro clean(txt) %}
  {{- (txt|string)
      | striptags
      | trim
      | replace({'\n':' ','\r':' '})
      | replace({'  ':' '})
  -}}
{% endmacro %}

{% import _self as H %}
{% set shopName = ceresConfig.header.companyName ?: 'Shop' %}
{% set title = shopName %}
{% set desc  = '' %}

{% if services.template.isCurrentTemplate('tpl.item') and item is defined and item.documents|length > 0 %}
  {% set d = item.documents[0].data %}

  {# Suche Properties in variationProperties (gruppierte Struktur) #}
  {% set titleProp = '' %}
  {% set descProp  = '' %}
  {% for group in d.variationProperties|default([]) %}
    {% for prop in group.properties|default([]) %}
      {% if prop.id == PROP_TITLE_ID and titleProp == '' %}
        {% set titleProp = prop.values.value ?? '' %}
      {% endif %}
      {% if prop.id == PROP_DESC_ID and descProp == '' %}
        {% set descProp = prop.values.value ?? '' %}
      {% endif %}
    {% endfor %}
  {% endfor %}

  {% set name1 = d.texts.name1 ?? d.texts.name2 ?? d.texts.name3 ?? '' %}
  {% set brand = d.manufacturer.name ?? '' %}

  {% set metaDesc = descProp ?: (d.texts.metaDescription ?? '') %}
  {% if not metaDesc %}
    {% set short = d.texts.shortDescription ?? '' %}
    {% set metaDesc = short ? H.clean(short) : '' %}
  {% endif %}

  {% set title = (titleProp ? H.clean(titleProp) : H.clean(name1)) ~ (brand ? ' | ' ~ H.clean(brand) : '') ~ ' | ' ~ shopName %}
  {% set desc  = H.clean(metaDesc)|slice(0,160) %}

{% else %}
  {% set title = shopName %}
  {% set desc = 'Jetzt ' ~ shopName ~ ' besuchen.' %}
{% endif %}

<title>{{ title }}</title>
<meta name="description" content="{{ desc }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ desc }}">
