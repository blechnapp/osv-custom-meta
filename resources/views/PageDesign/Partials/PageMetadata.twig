{% set details = null %}
{% if category is defined and category is not null %}
    {% set details = category.details[0] %}
{% endif %}

{% set robots = '' %}
{% set description = '' %}
{% set keywords = '' %}
{% set image = '' %}
{% set title = '' %}

{% if block('robots') is defined %}
    {% set robots = block('robots') | default('NOINDEX, NOFOLLOW') %}
{% elseif details is not null %}
    {% set robots = services.SEO.getRobotsInformation() %}
{% endif %}

{% if block('description') is defined %}
    {% set description = block('description') %}
{% elseif details is not null %}
    {% set description = details.metaDescription %}
{% endif %}

{% if block('keywords') is defined %}
    {% set keywords = block('keywords') %}
{% elseif details is not null %}
    {% set keywords = details.metaKeywords %}
{% endif %}

{% set companyLogo = ceresConfig.header.companyLogo %}
{% if block('image') is defined %}
    {% set image = block('image') | default(companyLogo) %}
{% elseif details is not null %}
    {# OSVCustomMeta 3.2.1: Bild 2 (Kachel) als Rueckfall vor dem Firmenlogo #}
    {% set image = details.imagePath | default(details.image2Path) | default(companyLogo) %}
{% endif %}

{% if block('title') is defined %}
    {% set title = block('title') %}
{% elseif details is not null %}
    {% set title = details.metaTitle | default(details.name) %}
{% endif %}

{# OSVCustomMeta: Auf Artikelseiten Titel, Beschreibung und Bild der Variante statt des Artikels.
   Eigenschaft 288 = Meta-Titel, 289 = Meta-Beschreibung, Bild = erstes Bild der Variante.
   Leere Werte lassen den Ceres-Standard stehen. Sonst identisch mit Ceres 5.0.83-5.0.85. #}
{% set osvTitleSet = false %}
{% if itemData is defined and itemData is not null %}
    {% set osvTitle = '' %}
    {% set osvDesc = '' %}
    {% for group in itemData.variationProperties|default([]) %}
        {% for prop in group.properties|default([]) %}
            {% if prop.id == 288 and prop.values.value|default('') != '' %}{% set osvTitle = prop.values.value|striptags|trim %}{% endif %}
            {% if prop.id == 289 and prop.values.value|default('') != '' %}{% set osvDesc = prop.values.value|striptags|trim %}{% endif %}
        {% endfor %}
    {% endfor %}
    {% if osvTitle %}
        {% set title = (osvTitle|slice(0,60) ~ ' | Seiffener Volkskunst')|e %}
        {% set osvTitleSet = true %}
    {% endif %}
    {% if osvDesc %}
        {% set description = osvDesc|slice(0,160) %}
    {% endif %}
    {% if itemData.images is defined and itemData.images.variation is defined and itemData.images.variation|length > 0 and itemData.images.variation[0].url|default('') != '' %}
        {% set image = itemData.images.variation[0].url %}
    {% endif %}
{% endif %}

{# OSVCustomMeta 3.4.0: Hauptbild der Artikelseite vorladen (LCP am Handy).
   Ceres baut die Galerie erst per JavaScript, das Bild wurde dadurch spaet angefordert.
   Bildwahl wie die Galerie: Bilder der Variante, sonst des Artikels, jeweils kleinste Position, Groesse full.
   Adresse wie Ceres sie anzeigt: bei /item/images/ und jpg/png/webp wird .avif angehaengt,
   type="image/avif" laesst Browser ohne AVIF den Hinweis ignorieren. Schalter: Konfiguration „Vorladen“. #}
{% set osvPreload = '' %}
{% set osvSchalter = config('OSVCustomMeta.preloadAktiv') %}
{% set osvVorladen = osvSchalter is null or (osvSchalter ~ '') not in ['false', '0', ''] %}
{% if itemData is defined and itemData is not null and osvVorladen %}
    {% set osvBilder = itemData.images.variation | default([]) %}
    {% if osvBilder | length == 0 %}
        {% set osvBilder = itemData.images.all | default([]) %}
    {% endif %}
    {% set osvErstes = null %}
    {% for osvBild in osvBilder %}
        {% if osvBild.url | default('') != '' and (osvErstes is null or osvBild.position | default(0) < osvErstes.position | default(0)) %}
            {% set osvErstes = osvBild %}
        {% endif %}
    {% endfor %}
    {% if osvErstes is not null and '/item/images/' in osvErstes.url %}
        {% for osvEndung in ['.jpg', '.JPG', '.jpeg', '.JPEG', '.png', '.PNG', '.webp'] %}
            {% if osvErstes.url ends with osvEndung %}
                {% set osvPreload = osvErstes.url ~ '.avif' %}
            {% endif %}
        {% endfor %}
    {% endif %}
{% endif %}

{% set type             = block('type') | default('article') %}
{% set url              = block('url') | default(services.url.getCanonicalURL()) | default(webstoreConfig.domainSsl) %}

{% if not osvTitleSet and (removeTitleCompanyName is not defined or not removeTitleCompanyName) %}
    {% if title | trim is not empty %}
        {% set title = title ~ " | " %}
    {% endif %}
    {% set title = title ~ trans("Ceres::Template.headerCompanyName") %}
{% endif %}

{# OSVCustomMeta 3.2.1: Vorschaubild auf Kategorie- und Inhaltsseiten.
   Reihenfolge: Bild 1 (Vorschau) -> Bild 2 (Kachel) -> festes Teilen-Bild aus diesem Plugin.
   Ausgabe immer als vollstaendige Adresse, nie leer und nie ein Ordner (WhatsApp, Teams, Facebook). #}
{% set osvDefaultImage = plugin_path('OSVCustomMeta') ~ "/images/vorschau_standard.jpg" %}
{% set osvDefaultUsed = false %}
{% set image = image | trim %}

{% if image starts with 'category/' %}
    {% set image = "/documents/" ~ image %}
{% endif %}

{% if image is empty %}
    {% set image = osvDefaultImage %}
    {% set osvDefaultUsed = true %}
{% elseif image starts with '/' %}
    {% set image = webstoreConfig.domainSsl ~ image %}
{% elseif image starts with 'layout/' %}
    {% set image = webstoreConfig.domainSsl ~ "/" ~ image %}
{% elseif not (image starts with 'https://' or image starts with 'http://') %}
    {% set image = plugin_path('Ceres') ~ "/" ~ image %}
{% endif %}

{% if osvPreload is not empty %}
<link rel="preload" as="image" type="image/avif" fetchpriority="high" href="{{ osvPreload }}">
{% endif %}
<meta name="robots" content="{% if forceNoIndex %}NOINDEX{% else %}{{ robots }}{% endif %}">
{% if description | trim is not empty %}
    <meta name="description" content="{{ description | trim }}">
{% endif %}
{% if keywords | trim is not empty %}
    <meta name="keywords" content="{{ keywords | trim }}">
{% endif %}
<meta property="og:title" content="{{ title | trim | raw }}"/>
<meta property="og:type" content="article"/>
<meta property="og:url" content="{{ url | trim }}"/>
<meta property="og:site_name" content="{{ trans("Ceres::Template.headerCompanyName") }}"/>
{% if description | trim is not empty %}
<meta property="og:description" content="{{ description | trim }}"/>
{% endif %}
<meta property="og:image" content="{{ image | trim }}"/>
{% if osvDefaultUsed %}
<meta property="og:image:width" content="1200"/>
<meta property="og:image:height" content="630"/>
{% endif %}
<meta property="thumbnail" content="{{ image | trim }}"/>
<meta name="twitter:card" content="summary_large_image"/>

<script type="application/ld+json">
{% block schemaOrg %}
{
    "@context": "http://schema.org",
    "@type": "WebSite",
    "url": "{{ url | raw }}"
    {% if services.template.isHome() %}
    ,"potentialAction":{
        "@type": "SearchAction",
        "target": "{{ webstoreConfig.domainSsl ~ urls.search }}?query={search_term}",
        "query-input": "required name=search_term"
    }
    {% endif %}
}
{% endblock %}
</script>

<title>{{ title | trim | raw }}</title>
